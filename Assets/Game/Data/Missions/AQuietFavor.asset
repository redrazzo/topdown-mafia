    ObjectiveText: Drive to the family office.
    NextStageId: handoff
    CreatesCheckpoint: 1
  - Id: handoff
    Title: Hand over the ledger
    ObjectiveText: Deliver the ledger inside the back office.
    NextStageId: leave
    CreatesCheckpoint: 1
  - Id: leave
    Title: Leave the office
    ObjectiveText: Walk back outside clean.
    NextStageId: 
    CreatesCheckpoint: 0
  checkpoints:
