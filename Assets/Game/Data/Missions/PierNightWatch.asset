  missionId: mission-pier-night-watch
  title: Pier Night Watch
  summary: Check the late pier crew, confirm who is skimming the crates, and leave
    the harbor before the watch changes.
  startingStageId: check-pier
  cashReward: 500
  reputationDelta: 2
  unlockDistrictIds: []
  unlockActivityIds: []
  stages:
  - Id: check-pier
    Title: Check the pier
    ObjectiveText: Search the late pier line for the marked crate.
