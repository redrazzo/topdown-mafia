  startingNodeId: vincent-intro
  nodes:
  - Id: vincent-intro
    SpeakerName: Vincent D'Agostino
    Text: Luca says you can drive and keep your mouth shut. Both are rare.
    NextNodeId: tommy-response
  - Id: tommy-response
    SpeakerName: Tommy Bell
    Text: I brought the ledger. That's all I was told to do.
