  m_Script: {fileID: 11500000, guid: d361d1478be707849baa105697b94022, type: 3}
  m_Name: BookkeeperWarning
  m_EditorClassIdentifier: MafiaTopDown.Runtime::MafiaTopDown.Gameplay.Runtime.Data.DialogueSequenceAsset
  dialogueId: dialogue-bookkeeper-warning
  displayName: Bookkeeper Warning
  startingNodeId: bookkeeper-open
  nodes:
  - Id: bookkeeper-open
    SpeakerName: Nico Bellori
    Text: The union books were supposed to stay between the men who bled for them.
    NextNodeId: tommy-warning
  - Id: tommy-warning
    SpeakerName: Tommy Bell
    Text: Those books belong to the family now. Consider this your quiet notice.
    NextNodeId: bookkeeper-close
  - Id: bookkeeper-close
    SpeakerName: Nico Bellori
    Text: Then I suppose I just became an expensive friend to have.
    NextNodeId: 
