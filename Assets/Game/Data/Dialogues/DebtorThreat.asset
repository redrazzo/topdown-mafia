  m_Name: DebtorThreat
  m_EditorClassIdentifier: MafiaTopDown.Runtime::MafiaTopDown.Gameplay.Runtime.Data.DialogueSequenceAsset
  dialogueId: dialogue-debtor-threat
  displayName: Debtor Threat
  startingNodeId: debtor-open
  nodes:
  - Id: debtor-open
    SpeakerName: Pietro Sava
    Text: I told your men I need one more Sunday. The church can vouch for me.
    NextNodeId: tommy-threat
  - Id: tommy-threat
    SpeakerName: Tommy Bell
    Text: The family owns your Sundays now. Next week, you pay in cash or blood.
    NextNodeId: debtor-close
  - Id: debtor-close
    SpeakerName: Pietro Sava
    Text: "Then I\u2019ll be waiting outside the chapel with an envelope and a prayer."
